<%- include("../partials/_html-head.ejs", {title: 'food'}) %>
<%- include("../partials/_nav-bar.ejs") %>
<article>
  <h1><%= otherUser %>'s Pantry</h1>
  <% if (pantry.length === 0) { %>
  <p><%= otherUser %> has nothing in their pantry</p>
  <% } else { %>

  <ul>
    <% pantry.forEach((food)=>{ %>
    <li><%= food.name %></li>
    <% }) %>
  </ul>
  <% } %>
</article>
</body>

</html>