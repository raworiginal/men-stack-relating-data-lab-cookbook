<%- include('../partials/_html-head.ejs', {title: 'Pantry'}) %>
<%- include('../partials/_nav-bar.ejs') %>
<main>
  <h1>Welcome to Your Pantry</h1>
  <% if (pantry.length === 0) { %>
  <p>There is nothing in this pantry</p>
  <% } else { %>
  <ul>
    <% pantry.forEach((food) => { %><a href="/users/<%= user._id %>/foods/<%= food._id %>">
      <li>
        <%= food.name %>
      </li>
    </a>
    <% }) %>
  </ul>
  <% } %><a href="/users/<%= user._id %>/foods/new"> <button>Add
      new</button> </a>
  </main>
</body>

</html>